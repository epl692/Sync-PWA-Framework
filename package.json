{
  "name": "sync-pwa-framework",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:property": "vitest run packages/core/tests/property",
    "test:contract": "vitest run contract",
    "e2e": "playwright test",
    "bench": "vitest bench --run",
    "relay-server": "tsx packages/relay-server/src/server.ts",
    "dev": "echo \"run dev in a specific workspace, e.g. npm run dev -w @sync/transport-webrtc\"",
    "test:adversarial": "vitest run packages/spaces/tests/adversarial"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.0.0",
    "fake-indexeddb": "^6.0.0",
    "fast-check": "^3.23.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.1.0"
  }
}
